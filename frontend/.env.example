# Copie este arquivo para ".env.local" (que não vai para o Git) e ajuste.
# URL base da API do Venue Intelligence Core.
VITE_API_BASE_URL=https://api-venue.onrender.com

# Token Bearer das rotas protegidas (despacho, insumos, predições). Só no .env.local, nunca no Git.
# O token de desenvolvimento está na descrição do Swagger da API (/docs, botão Authorize).
# VITE_API_TOKEN=

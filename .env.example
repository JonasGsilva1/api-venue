# ==============================================================================
# VENUE INTELLIGENCE CORE / RAIZEVENTO — VARIÁVEIS DE AMBIENTE
# ==============================================================================

# Porta da aplicação (gerenciada automaticamente pelo Render via $PORT; padrão local: 8000)
PORT=8000

# ── 1. SEGURANÇA E AUTENTICAÇÃO (JWT / RBAC) ──────────────────────────────────
# Token de desenvolvimento aceito com perfil admin (usado no botão Authorize do Swagger)
DEV_TOKEN=dev-raiz-token-2026

# Chave secreta para assinatura dos tokens JWT HS256 (troque em produção)
JWT_SECRET=raizevento-dev-secret-troque-em-producao-2026

# Tempo de expiração do JWT emitido em minutos (padrão: 480 min = 8 horas)
JWT_EXPIRACAO_MIN=480

# Habilita o endpoint de emissão rápida de JWT por papel POST /api/v1/auth/token (true/false)
AUTH_DEV_ISSUER=true

# Modo permissivo para desenvolvimento: se true, requisições sem token viram 'operador' (padrão: false)
AUTH_PERMISSIVE=false

# ── 2. MOTOR DE IA E RESILIÊNCIA ──────────────────────────────────────────────
# Orçamento de timeout do motor de inferência em segundos (acima disso dispara MEDIA_MOVEL_504)
AI_ENGINE_TIMEOUT_SEG=2.5

# ── 3. ANALYTICS DE NEGÓCIO (DROPOFF / CES) ───────────────────────────────────
# Janela útil do participante em minutos (padrão: 30 min)
WINDOW_TIME_MIN=30

# Tempo médio estimado de deslocamento no estande/arena em minutos (padrão: 8 min)
DESLOCAMENTO_MEDIO_MIN=8

# ── 4. CORS E REDE ────────────────────────────────────────────────────────────
# Origens permitidas separadas por vírgula (use * para liberar geral)
CORS_ORIGINS=*

# Desativa o buffer de saída do Python para logs imediatos em tempo real
PYTHONUNBUFFERED=1

{
  "name": "@venue-intelligence/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Venue Intelligence Core — API Gateway (Node.js + TypeScript). Contratos Zod .strict(), Swagger em /docs, resiliência 400/502/503/504 e SSE em tempo real.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:export": "tsx src/docs/export-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/ws": "^8.18.2",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.7.2",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}

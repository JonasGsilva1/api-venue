# Porta HTTP do API Gateway (PROJECT_CONTEXT.md §3)
PORT=3000
# URL base do motor de IA em Python (services/ai-engine)
AI_ENGINE_URL=http://localhost:8000
# Timeout estrito da inferência — acima disso aplica-se MEDIA_MOVEL_504 (PROJECT_CONTEXT.md §6.3)
AI_ENGINE_TIMEOUT_MS=2500
# Timeout do ping de prontidão do ai-engine (readiness S01)
AI_ENGINE_PING_TIMEOUT_MS=800
# Window Time configurado para cálculo de Drop-off Rate (minutos)
WINDOW_TIME_MIN=30
# Tempo médio de deslocamento até o ponto de consumo (minutos)
DESLOCAMENTO_MEDIO_MIN=8
# Origens permitidas para CORS (separadas por vírgula, "*" para todas)
CORS_ORIGINS=*
